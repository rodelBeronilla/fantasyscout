---
import Base from '../../layouts/Base.astro';
import schema from '../../generated/schema.json';
import { href } from '../../lib/site';

const count = (layer: string) => schema.layers.find((l) => l.name === layer)?.models.length ?? 0;
const checks = schema.checks as { severity: string }[];
const errors = checks.filter((c) => c.severity === 'error').length;
const warns = checks.length - errors;
const f = schema.fantasy as {
  fantasy: Record<string, { teams: number; roster_spots: number; prior_games: number; durability_games: number; minutes_recency: number[] }>;
  fantasy_recency: number[];
  fantasy_durability: { typical_share: number };
};
const m = (name: string) => href(`/schema/#m-${name}`);

// The diagram: boxes on a 720-wide canvas, top to bottom in the order data moves.
interface Box {
  id: string;
  x: number;
  y: number;
  w: number;
  title: string;
  sub: string;
  tone?: 'accent';
}
const H = 52;
const boxes: Box[] = [
  { id: 'sources', x: 40, y: 10, w: 300, title: 'League stats API', sub: 'stats.wnba.com · stats.nba.com · 9 endpoints' },
  { id: 'sources', x: 380, y: 10, w: 300, title: 'ESPN public API', sub: 'scoreboard · summary · rosters · injuries' },
  { id: 'ingest', x: 40, y: 94, w: 300, title: 'Ingest on the home runner', sub: 'paced client, daily 09:15 UTC + backfills' },
  { id: 'ingest', x: 380, y: 94, w: 300, title: 'Ingest on GitHub runners', sub: 'same client, same schedule' },
  { id: 'landing', x: 190, y: 178, w: 340, title: 'Landing', sub: 'raw JSON as fetched · Unity Catalog volume' },
  { id: 'bronze', x: 190, y: 262, w: 340, title: `Bronze · ${count('bronze')} models`, sub: 'incremental, one model per endpoint' },
  { id: 'silver', x: 190, y: 346, w: 340, title: `Silver · ${count('silver')} models`, sub: 'typed, deduplicated, crosswalks, lineups' },
  { id: 'gold', x: 100, y: 430, w: 300, title: `Gold · ${count('gold')} models`, sub: 'star schema + fantasy marts' },
  { id: 'ops', x: 430, y: 430, w: 250, title: `Ops · ${count('ops')} models`, sub: 'run log, reconciliation' },
  { id: 'gate', x: 190, y: 514, w: 340, title: 'Quality gate', sub: `${errors} blocking + ${warns} warning checks`, tone: 'accent' },
  { id: 'export', x: 190, y: 598, w: 340, title: 'Export to R2', sub: 'immutable build, pointer flipped last' },
  { id: 'serving', x: 10, y: 682, w: 165, title: 'Worker + app', sub: 'board, players, health' },
  { id: 'serving', x: 190, y: 682, w: 165, title: 'SQL console', sub: 'DuckDB in the browser' },
  { id: 'analysis', x: 370, y: 682, w: 165, title: 'Notebooks', sub: 'run on every build' },
  { id: 'analysis', x: 550, y: 682, w: 165, title: 'Tableau', sub: 'via a Google Sheet' },
];
const at = (i: number) => boxes[i]!;
const bottom = (b: Box) => ({ x: b.x + b.w / 2, y: b.y + H });
const top = (b: Box) => ({ x: b.x + b.w / 2, y: b.y });
const edges: [number, number][] = [
  [0, 2], [1, 3], [2, 4], [3, 4], [4, 5], [5, 6], [6, 7], [6, 8], [7, 9], [8, 9], [9, 10], [10, 11], [10, 12], [10, 13], [10, 14],
];
const paths = edges.map(([a, b]) => {
  const s = bottom(at(a));
  const e = top(at(b));
  const mid = (s.y + e.y) / 2;
  return `M${s.x},${s.y} C${s.x},${mid} ${e.x},${mid} ${e.x},${e.y - 4}`;
});
const VIEW_H = 682 + H + 10;
---

<Base
  title="Pipeline"
  description="How data moves from the league and ESPN APIs to the site: ingestion, the lakehouse layers, reconciliation, the fantasy methods, the quality gate, the export and serving."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Pipeline</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      End to end, from two public APIs to this site. Data is fetched once a day, landed as the raw JSON, modelled in dbt on
      Databricks through bronze, silver and gold, checked, and published only when the checks pass. Every box links to how
      that stage works; every model is on the <a href={href('/schema/')} class="underline underline-offset-4">Schema</a> page.
    </p>

    <figure class="mt-6 overflow-x-auto rounded-lg border border-line bg-card p-2" tabindex="0" aria-labelledby="pipeline-caption">
      <figcaption id="pipeline-caption" class="sr-only">
        Pipeline diagram: sources, ingest, landing, bronze, silver, gold and ops, the quality gate, the export, and the
        surfaces that read it. Each box links to its section below.
      </figcaption>
      <svg viewBox={`0 0 720 ${VIEW_H}`} class="mx-auto w-full max-w-3xl min-w-[560px]" data-testid="pipeline-diagram">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" class="fill-muted" />
          </marker>
        </defs>
        <g class="stroke-muted" fill="none" stroke-width="1.5">
          {paths.map((d) => <path d={d} marker-end="url(#arrow)" />)}
        </g>
        {
          boxes.map((b) => (
            <a href={`#${b.id}`}>
              <rect
                x={b.x}
                y={b.y}
                width={b.w}
                height={H}
                rx="8"
                class:list={[b.tone === 'accent' ? 'fill-bg stroke-accent' : 'fill-bg stroke-line']}
                stroke-width={b.tone === 'accent' ? 2 : 1}
              />
              <text x={b.x + b.w / 2} y={b.y + 22} text-anchor="middle" class="fill-fg text-[14px] font-semibold">
                {b.title}
              </text>
              <text x={b.x + b.w / 2} y={b.y + 40} text-anchor="middle" class="fill-muted text-[11px]">
                {b.sub}
              </text>
            </a>
          ))
        }
      </svg>
    </figure>

    <div class="mt-8 grid max-w-3xl grid-cols-[minmax(0,1fr)] gap-8 text-sm leading-relaxed" data-testid="pipeline-stages">
      <section id="sources">
        <h2 class="text-lg font-semibold tracking-tight">1. Sources</h2>
        <p class="mt-2">
          Two public sources, both leagues. The league stats API is the system of record for games, box scores, play-by-play,
          shots, schedules and rosters: nine endpoints (schedule, player directory, game logs, traditional and advanced box
          scores, play-by-play, shot charts, team rosters). ESPN's public JSON adds a second box score per game for
          reconciliation, team and roster directories, and the injury report.
        </p>
      </section>

      <section id="ingest">
        <h2 class="text-lg font-semibold tracking-tight">2. Ingest</h2>
        <p class="mt-2">
          A daily workflow at 09:15 UTC, after the night's games are final, plus a backfill workflow that fans out one job per
          league, season and season type. The stats hosts refuse cloud runner addresses, so stats requests run on self-hosted
          runner containers at home; ESPN runs on GitHub-hosted runners (ADR 0002).
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Pacing.</strong> One client paces each host: 1.5 to 3 s between requests with ±30% jitter for daily runs.
            Backfills use an adaptive pace that only speeds up after ten clean, fast responses in a row, slows down twofold on
            a 429 and 1.5-fold on an error, and opens a circuit after three timeouts in a row.
          </li>
          <li>
            <strong>Bot-manager cookies.</strong> The client drops its cookies before every request; a long-lived session's
            cookies made every request hang to the read timeout.
          </li>
          <li>
            <strong>Request economy (ADR 0004).</strong> Shots are fetched per team-season and the advanced line per season
            from the game logs, instead of per game.
          </li>
          <li>
            <strong>Idempotent.</strong> A run skips every payload already landed; a source that answers "not found" is
            recorded as missing at source, not as a failure. Each run writes a log the Data Health page reads.
          </li>
        </ul>
      </section>

      <section id="landing">
        <h2 class="text-lg font-semibold tracking-tight">3. Landing</h2>
        <p class="mt-2">
          Each response is stored exactly as fetched, as JSON in a Unity Catalog volume, under source, endpoint, league,
          season and landing date. Nothing is transformed on the way in, so any model can be rebuilt from scratch from what
          landed.
        </p>
      </section>

      <section id="bronze">
        <h2 class="text-lg font-semibold tracking-tight">4. Bronze</h2>
        <p class="mt-2">
          The dbt project runs on Databricks after every ingest and on DuckDB in CI, from the same SQL: engine differences
          (JSON access, file listing, hashing, dates, fuzzy matching) live in adapter-dispatched macros. Bronze turns landed
          files into rows, one incremental model per endpoint. Each run appends only files newer than what it holds and not
          loaded before, and every row keeps its source file and landing date.
        </p>
      </section>

      <section id="silver">
        <h2 class="text-lg font-semibold tracking-tight">5. Silver</h2>
        <p class="mt-2">
          Typed and deduplicated (the latest landing wins), with keys tested unique. Game types come from the game id, and a
          neutral-site game that both teams list as home is folded into one.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Reconciliation (ADR 0005).</strong> <a href={m('team_xwalk')} class="underline underline-offset-4">Teams</a>
            and <a href={m('game_xwalk')} class="underline underline-offset-4">games</a> are matched across sources on team
            and Eastern game date. <a href={m('player_xwalk')} class="underline underline-offset-4">Players</a> match by
            exact name in either order, nickname or first and last name, then by fuzzy name similarity with birth date, then
            by a hand-kept override seed, keeping mutual best matches only. Every player-game's two box scores are compared
            stat by stat as exact, minor or conflict; the league's figure wins unless it is missing.
          </li>
          <li>
            <strong>Lineups.</strong> <a href={m('event_lineups')} class="underline underline-offset-4">event_lineups</a>
            puts the five players a side on the floor for every play-by-play action. Substitutions name only the player
            leaving by id; the player coming on is matched to the box score by ranked name rules (given-name prefixes,
            suffixes, changed names, reversed names), and events are ordered by game clock because the feed logs some
            substitutions late.
          </li>
        </ul>
      </section>

      <section id="gold">
        <h2 class="text-lg font-semibold tracking-tight">6. Gold and the fantasy methods</h2>
        <p class="mt-2">
          A star schema: <a href={m('dim_player')} class="underline underline-offset-4">players</a> with team history as
          slowly changing stints from where they actually played, teams, games and dates; facts per player-game, team-game,
          play-by-play action with lineups, shot, and injury listing. On top, the fantasy marts.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Category z-scores</strong> (<a href={m('mart_category_zscores')} class="underline underline-offset-4">mart_category_zscores</a>):
            per season and over the last 10 and 20 games, against a pool of the top 180 NBA or 90 WNBA players by minutes.
            Counting categories use per-game averages, turnovers count negative, and percentages are volume-weighted:
            (player % minus pool %) times attempts per game.
          </li>
          <li>
            <strong>Projection</strong> (<a href={m('mart_player_projection')} class="underline underline-offset-4">mart_player_projection</a>),
            for players on a current roster only. Production per minute, with seasons weighted by minutes played and a recency of
            {f.fantasy_recency.join(', ')} (this season, last, the one before). Minutes per game, by games played, with a minutes
            recency of {f.fantasy.nba?.minutes_recency.join(', ')} in the NBA and {f.fantasy.wnba?.minutes_recency.join(', ')} in the
            WNBA, whose roles move more. The per-game line is the rate times the minutes. Every projection starts from
            {f.fantasy.nba?.prior_games} (NBA) or {f.fantasy.wnba?.prior_games} (WNBA) games of a replacement-level player, so
            short samples move it only part of the way.
          </li>
          <li>
            <strong>Value above replacement</strong> (<a href={m('mart_board')} class="underline underline-offset-4">mart_board</a>):
            the projections are scored in two passes against the players a fantasy league rosters
            ({f.fantasy.nba?.teams} teams × {f.fantasy.nba?.roster_spots} in the NBA, {f.fantasy.wnba?.teams} × {f.fantasy.wnba?.roster_spots}
            in the WNBA), and each category has replacement level, the next players after that pool, subtracted. Zero is a
            freely available player, and a punt build is the sum without the punted categories.
          </li>
          <li>
            <strong>Games played.</strong> The share of team regular-season games a player played, regressed toward
            {Math.round(f.fantasy_durability.typical_share * 100)}% by {f.fantasy.nba?.durability_games} (NBA) or
            {f.fantasy.wnba?.durability_games} (WNBA) games, turns value per game into value.
          </li>
          <li>
            <strong>Availability and rest of season.</strong> Injury listings are linked to players by name within the team.
            Rest of season scales value above replacement by the team's remaining regular-season games and the share of them
            the player is expected to play (out until the expected return, doubtful 0.75 of a game, questionable 0.5,
            day-to-day 0.25).
          </li>
          <li>
            <strong>Chosen by backtest.</strong> The weights and priors were picked by replaying past seasons before they
            started and a tenth, a quarter and half way in, and scoring how much of each predicted top tier and rostered pool
            finished there (ADR 0003).
          </li>
        </ul>
      </section>

      <section id="ops">
        <h2 class="text-lg font-semibold tracking-tight">7. Ops</h2>
        <p class="mt-2">
          The ingest run log, every reconciliation difference with how it was resolved, and the match and conflict rates per
          league and season, printed in every build log and shown on <a href={href('/health/')} class="underline underline-offset-4">Data Health</a>.
          A read-only workflow prints any table into a job log for investigation.
        </p>
      </section>

      <section id="gate">
        <h2 class="text-lg font-semibold tracking-tight">8. Quality gate</h2>
        <p class="mt-2">
          After every build, {schema.generic_tests} column tests and {checks.length}
          <a href={href('/schema/#checks')} class="underline underline-offset-4">data-quality checks</a> run on the real data:
          completeness against the schedule, in-season freshness, box-score arithmetic and closure, rostered players and sane
          values on the board, and warnings for volume anomalies, crosswalk coverage, injury links and lineup completeness.
          The results are written to <code>ops.test_results</code> and <code>ops.publish_gate</code>. An error-severity
          failure closes the gate: nothing is exported, and an incident issue opens with samples of the failing rows and closes
          itself on the next passing build.
        </p>
      </section>

      <section id="export">
        <h2 class="text-lg font-semibold tracking-tight">9. Export (ADR 0006)</h2>
        <p class="mt-2">
          A passing build is exported to Cloudflare R2 as an immutable build folder: Parquet for every gold and ops table (the
          big facts split per league and season), compact JSON for what the pages render (rounded to four decimals), one file
          per player, a health summary, and a manifest. <code>latest.json</code> is rewritten last, so a reader never sees a
          half-written build; seven builds are kept, and rolling back is rewriting the pointer.
        </p>
      </section>

      <section id="serving">
        <h2 class="text-lg font-semibold tracking-tight">10. Serving</h2>
        <p class="mt-2">
          A Cloudflare Worker serves this static Astro site and the build files from R2: build files are cached as immutable,
          the pointer for a minute. The content security policy allows no inline code except what it lists by hash. Pages
          render their data in the browser; the SQL console runs DuckDB compiled to WebAssembly over the build's Parquet files.
          Every change runs page tests, accessibility checks and a phone-width check, and every deploy a load-time budget.
        </p>
      </section>

      <section id="analysis">
        <h2 class="text-lg font-semibold tracking-tight">11. Analysis</h2>
        <p class="mt-2">
          Three <a href={href('/notebooks/')} class="underline underline-offset-4">notebooks</a> (shot profiles, the
          reconciliation audit, a fantasy value backtest) run against every published build and publish their findings. A
          Tableau extract is pushed into a Google Sheet after every export, so the
          <a href={href('/dashboards/')} class="underline underline-offset-4">dashboard</a> refreshes itself.
        </p>
      </section>
    </div>
  </section>
</Base>
