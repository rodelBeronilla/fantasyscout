---
import Diagram from '../../components/Diagram.astro';
import Base from '../../layouts/Base.astro';
import schema from '../../generated/schema.json';
import { dailyRun, dataFlowCollect, dataFlowPublish, deploymentCollect, deploymentPublish, valueActivity } from '../../lib/pipeline-diagrams';
import { href } from '../../lib/site';

interface Model {
  name: string;
  materialized: string;
  exported_as: string[];
  columns: { name: string }[];
}
const layers = schema.layers as { name: string; models: Model[] }[];
const models = (layer: string) => layers.find((l) => l.name === layer)?.models ?? [];
const count = (layer: string) => models(layer).length;
const gold = models('gold');
const dims = gold.filter((m) => m.name.startsWith('dim_'));
const facts = gold.filter((m) => m.name.startsWith('fct_'));
const marts = gold.filter((m) => m.name.startsWith('mart_'));
const incrementalGold = gold.filter((m) => m.materialized === 'incremental');
const notExported = [...gold, ...models('ops')].filter((m) => m.exported_as.length === 0);
const partitioned = gold.filter((m) => m.exported_as.some((f) => f.includes('<league>-<season>')));
const hashed = models('bronze').filter((m) => m.columns.some((c) => c.name === '_payload_hash')).length;

const landing = schema.landing as { path: string; read_by: string[] }[];
const folders = (source: string) => landing.filter((l) => l.path.startsWith(`${source}/`)).map((l) => l.path.slice(source.length + 1));
const sharedFolders = landing.filter((l) => l.read_by.length > 1);

const checks = schema.checks as { name: string; severity: string }[];
const errorChecks = checks.filter((c) => c.severity === 'error');
const warnChecks = checks.filter((c) => c.severity !== 'error');
const unitTests = schema.unit_tests as { model: string }[];

const f = schema.fantasy as {
  fantasy: Record<string, { teams: number; roster_spots: number; prior_games: number; durability_games: number; minutes_recency: number[] }>;
  fantasy_recency: number[];
  fantasy_durability: { typical_share: number };
  fantasy_team_change: number;
  fantasy_recent_minutes: number;
  fantasy_matchup: { prior_games: number };
};
const nba = f.fantasy['nba']!;
const wnba = f.fantasy['wnba']!;
const m = (name: string) => href(`/schema/#m-${name}`);
/** "a, b and c" */
const list = (names: string[]) => (names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names.at(-1)}`);

const [collect, publish, deployCollect, deployPublish, activity] = await Promise.all([
  dataFlowCollect(),
  dataFlowPublish(),
  deploymentCollect(),
  deploymentPublish(),
  valueActivity(),
]);
const sequence = dailyRun();
const link = 'underline underline-offset-4';
const pill = 'rounded-full border border-line px-3 py-1 hover:bg-card';
const dfdLegend =
  'Bold boxes are external entities, rounded boxes are processes numbered by stage, cylinders are data stores (D1 to D6). A solid arrow carries the data it is labelled with; a dashed arrow is a condition and carries none. Dashed rounded boxes join the two diagrams. Every box links to its section.';
const deployLegend =
  'Shaded boxes are UML nodes (devices and cloud services); a box drawn inside another is deployed on it. Three-dimensional boxes are execution environments and hosts, folded notes are artefacts (programs and workflow jobs), cylinders are stores. Every arrow points from the caller to what it calls and is labelled with the protocol or API.';
---

<Base
  title="Pipeline"
  description="How data moves from six source families to this site: data-flow and deployment diagrams, the sequence of a day's runs, how board value is computed, and each of the seven stages in detail."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Pipeline</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      End to end, from six source families to this site. Ingest runs twice a day, at 09:15 and 23:00 UTC, and lands each
      response in a Databricks volume. After each run, dbt models what landed on Databricks through bronze, silver and gold,
      and a quality gate decides whether that build is published. A passing build is staged in Cloudflare R2, analysed,
      then promoted, and the Worker serves it to every page. The stages are numbered 1 to 7, the same in the diagrams and
      in the sections below. The diagrams are drawn when the site is built, with counts and settings read from the dbt
      project, and every model named here is on the <a href={href('/schema/')} class={link}>Schema</a> page.
    </p>

    <nav class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="On this page">
      <a href="#data-flow" class={pill}>Data flow</a>
      <a href="#deployment" class={pill}>Deployment</a>
      <a href="#daily-run" class={pill}>A day</a>
      <a href="#value" class={pill}>Board value</a>
      <a href="#stages" class={pill}>Stages 1 to 7</a>
      <a href="#workflows" class={pill}>Other workflows</a>
    </nav>

    <section id="data-flow" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">Data flow</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">Two diagrams: collecting and modelling (stages 1 to 3), then publishing and serving (stages 4 to 7).</p>
      <div id="dfd-collect">
        <Diagram id="dfd-collect" svg={collect} title="Data-flow diagram 1 of 2: sources to the gate" caption={dfdLegend} />
      </div>
      <div id="dfd-publish">
        <Diagram
          id="dfd-publish"
          svg={publish}
          title="Data-flow diagram 2 of 2: the gate to the reader"
          caption={`${dfdLegend} The Tableau workbook is not published yet, so the Dashboards page shows a notice in its place.`}
        />
      </div>
    </section>

    <section id="deployment" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">Deployment</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">
        Where each piece runs, in the same two halves. The other workflows (CI, Export data, Probe sources, Query the
        lakehouse, Run the notebooks) run on the same hosted runners.
      </p>
      <Diagram id="deploy-collect" svg={deployCollect} title="UML deployment diagram 1 of 2: ingest and the build" caption={deployLegend} />
      <Diagram
        id="deploy-publish"
        svg={deployPublish}
        title="UML deployment diagram 2 of 2: publishing and serving"
        caption={`${deployLegend} The build job is the same one as in diagram 1, after the gate.`}
      />
    </section>

    <section id="daily-run" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">A day</h2>
      <Diagram
        id="sequence"
        svg={sequence}
        title="UML sequence diagram"
        caption="Time runs downward. Solid arrows with filled heads are calls, dashed arrows are replies, open heads are messages that do not wait. A fragment marked alt runs only when its condition holds. The schedule starts Ingest twice a day: at 09:15 UTC with every source, at 23:00 UTC with the reports alone. Each finished Ingest run starts a build, so up to two builds a day go live."
      />
    </section>

    <section id="value" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">How board value is computed</h2>
      <Diagram
        id="activity"
        svg={activity}
        title="UML activity diagram"
        caption="From the per-season lines to the value and rest-of-season value on the board. The upper bar forks work that runs independently and the lower one joins it again; diamonds are decisions. Settings are read from the dbt project, so the numbers here are the ones in use."
      />
      <p id="rule" class="mt-4 max-w-3xl rounded-lg border border-line bg-card p-3 text-sm" data-testid="value-rule">
        <strong>What changes the value, and what is shown beside it.</strong> Only the projection (rate, minutes and games
        share) changes a player's value, and for rest of season the remaining schedule and the availability multiplier too.
        Everything else is shown beside the value and never moves it: on the board, the official injury status, the lineup
        role, the market rank, ownership and its trend, team stakes and rest risk, and the newest headline flag; on
        Streamers, Sleeper's waiver heat; on the schedule, betting lines, rest and travel.
      </p>
    </section>

    <div id="stages" class="mt-10 grid max-w-3xl grid-cols-[minmax(0,1fr)] gap-8 text-sm leading-relaxed" data-testid="pipeline-stages">
      <section id="ingest">
        <h2 class="text-lg font-semibold tracking-tight">1. Ingest</h2>

        <h3 id="sources" class="mt-3 font-semibold">Sources</h3>
        <p class="mt-1">Six source families, each fetched by its own module of the <code>ingest</code> package:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>The league stats API</strong> (stats.wnba.com, stats.nba.com), the system of record. Every run fetches
            per season the schedule, the player directory, the team game log, the player game logs (the advanced line, once
            per season) and the standings (<code>leaguestandingsv3</code>); per game in the window, the traditional box
            score, the play-by-play and the shot chart; and every team's roster. Of its {folders('stats').length} landing
            folders, <code>boxscoreadvancedv3</code> is no longer fetched: it holds files from before the season game logs
            replaced it, and bronze still reads them.
          </li>
          <li>
            <strong>ESPN's site API</strong> (site.api.espn.com): a scoreboard for each day of the window and, when the
            window ends today, for each of the next seven days, so upcoming games have their current betting line; a game
            summary for each completed game (a second box score for reconciliation, and the closing line); the team and
            roster directories and the injury listing; and, in the reports run, the latest 100 transactions and the latest
            50 headlines.
          </li>
          <li><strong>ESPN's fantasy API</strong> (lm-api-reads.fantasy.espn.com): each player's average draft position and how widely the player is rostered and started.</li>
          <li>
            <strong>The leagues' official injury reports</strong>, PDFs on ak-static.cms.nba.com. The NBA's newest report is
            found on its season index page at official.nba.com; the WNBA has no index, so the ingest tries each quarter hour
            of the last 24 hours, from May to October.
          </li>
          <li><strong>The league's static files</strong> on stats.nba.com/js/data (NBA only): the day's starting lineups, Expected and then Confirmed before tip-off, and the player movement feed.</li>
          <li><strong>The leagues' referee assignments</strong> at official.nba.com/referee-assignments/: each of the day's crews (crew chief, referee, umpire, alternate), posted at about 9 am ET, parsed and landed once a day per league. Past crews come from the ESPN game summaries already landed.</li>
          <li><strong>Sleeper's API</strong> (api.sleeper.app, NBA only): the 50 players most added and the 50 most dropped over the last 24 hours, and the player directory once a day.</li>
        </ul>
        <p class="mt-2">
          Every page's footer credits NBA.com and WNBA.com for the statistics, ESPN for schedules, rosters, injuries, betting
          lines, headlines and the fantasy market, Sleeper for waiver trends, and NBA.com for the referee assignments (ADR 0008).
        </p>

        <h3 id="runs" class="mt-4 font-semibold">Runs</h3>
        <p class="mt-1">
          The Ingest workflow runs on a schedule and on demand for any league, source or date range. At 09:15 UTC it runs
          three sources for both leagues: <code>stats</code> and <code>espn</code> over the seven days ending that day
          (the stats job makes a regular-season pass and a playoff pass; out of the playoffs the second finds no games),
          and <code>reports</code>. At 23:00 UTC, after teams file their injury reports (5 pm ET) and
          before tip-off, it runs <code>reports</code> alone. The reports run lands seven feeds in order: the official injury
          report, the starting lineups, the referee assignments, transactions (ESPN's, and the NBA's player movement), ESPN fantasy, ESPN headlines
          and Sleeper. For the WNBA the lineups, player movement and Sleeper have nothing to land.
        </p>
        <p class="mt-2">
          The ESPN and reports jobs run on GitHub-hosted runners, one per league in parallel. The stats API does not answer
          cloud runner addresses, so the stats jobs run on two self-hosted runner containers on a home server, and only when
          the repository variable naming that runner is set (ADR 0002). One stats job per league runs at a time, a limit
          shared with the Backfill workflow.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Pacing.</strong> Every request goes through one client, paced per host. The gap between requests starts
            at 2.25 s with ±30% jitter and adapts: ten fast answers in a row shrink it by a tenth, an answer slower than 3 s
            widens it by a fifth, an error, timeout or retryable status by half, and a 429 doubles it and adds a 30 s pause
            (longer if the server's Retry-After says so). Daily runs keep the gap between 1.5 and 3 s with a 30 s read
            timeout; backfills may go down to 0.75 s with a 20 s timeout. Up to five retries back off from 1 to 60 s, and
            three timeouts in a row on a host open a circuit that ends the run.
          </li>
          <li>
            <strong>Cookies.</strong> The client clears its cookies before every attempt: the stats hosts' bot-manager
            cookies made a long-lived session's requests hang until they timed out (ADR 0004).
          </li>
          <li>
            <strong>Request economy (ADR 0004).</strong> The advanced line comes from the player game logs once per season
            instead of per game. Backfills fetch shot charts per team and season; daily runs fetch one per game.
          </li>
          <li>
            <strong>What is not fetched again.</strong> A payload already checked that day is not requested again. A game's
            box score, play-by-play, shot chart, scoreboard and summary are settled once they have been checked two days
            after the game, and are not requested again either. A payload whose content hash matches its last landing is
            not written again; only its checked date moves. A full refresh bypasses all three.
          </li>
          <li>
            <strong>Failures.</strong> Every failed request is recorded and the rest of the run carries on; at the end the
            job fails and opens or updates an incident issue for that job, which the next passing run closes. The day's
            build still runs with what landed, and the next daily window fetches the missing payloads again. Some gaps are
            expected and pass silently: a missing ESPN game summary (404, recorded as missing at source), a day with no
            lineups file, an injury index with no report yet, WNBA report times with no PDF, months outside the WNBA
            season, and the NBA-only feeds on a WNBA run.
          </li>
        </ul>

        <h3 id="landing" class="mt-4 font-semibold">Landing</h3>
        <p class="mt-1">
          Every payload is written to the Unity Catalog volume as{' '}
          <code class="wrap-anywhere">landing/&lt;source&gt;/&lt;endpoint&gt;/&lt;league&gt;/&lt;season&gt;/&lt;date&gt;/&lt;key&gt;.json</code>, where the date is the
          ingest date (UTC), with a <code>.meta.json</code> sidecar (URL, parameters, status, size, SHA-256, fetch time)
          and an <code>_index.json</code> per endpoint, league and season. Every run also writes a run log under{' '}
          <code>landing/_ops/ingest_log/</code>. Most keys are a season, a game, a team or a date; the lineups, headlines
          and Sleeper's trending lists are keyed by the Eastern hour and the injury report by its publish time, so each
          run that finds something new lands a new file and history accumulates.
        </p>
        <p class="mt-2">
          The stats and ESPN site payloads land exactly as fetched. Five are changed on the way in: the injury-report PDF is
          parsed from its word positions into rows, and only the rows, the PDF's URL and its hash land; ESPN fantasy is
          trimmed to each player's id, name, team, position, ownership and draft ranks; ESPN headlines to the headline,
          date, link and tagged athletes, never the story; Sleeper's directory to active players on a team; and the player
          movement feed to its last 180 days. Every dbt model can be rebuilt from what landed, except the seeds, the gate's
          tables and the board ledger (<a href={m('fct_board_history')} class={link}>fct_board_history</a>), which only grows.
        </p>
      </section>

      <section id="model">
        <h2 class="text-lg font-semibold tracking-tight">2. Model</h2>
        <p class="mt-2">
          The Build workflow starts when an Ingest or Backfill run finishes, even with a failed job (not when it is
          cancelled), on a GitHub-hosted runner, one build at a time. It makes sure every landing folder exists, then runs{' '}
          <code>dbt build</code> on the Databricks SQL warehouse. The same project runs on DuckDB in CI over a small sample.
          Engine differences live in adapter-dispatched macros: JSON access, file listing, hashing, date arithmetic,
          regular expressions and fuzzy name matching, whose thresholds differ by engine. Dates are Eastern:{' '}
          <code>eastern_today()</code> and <code>as_of_date()</code> both give today's date in New York, the leagues' own
          day, on either engine.
        </p>

        <h3 id="bronze" class="mt-4 font-semibold">Bronze</h3>
        <p class="mt-1">
          {count('bronze')} incremental models that append rows, one per landing folder, except that{' '}
          {sharedFolders.map((s, i) => (
            <>
              {i > 0 && (i === sharedFolders.length - 1 ? ' and ' : ', ')}<code>{s.path}</code> feeds {s.read_by.length} ({list(s.read_by)})
            </>
          ))}. Each run reads the files landed on or after its newest landing date that it has not loaded. Every row keeps
          its source file, league, season, landing date and request key, and {hashed} of them also keep the payload's
          SHA-256. The summary's plays and team lines are modelled in bronze but not read further yet.
        </p>

        <h3 id="silver" class="mt-4 font-semibold">Silver</h3>
        <p class="mt-1">
          {count('silver')} tables: typed and deduplicated (the latest landing wins), keys tested unique, the game type read
          from the game id, and a neutral-site game that both teams list as home folded into one. Besides games, players,
          box scores, play-by-play and shots, silver holds the official injury report, each listing's status history, the
          lineups, transactions, standings, the ESPN fantasy market, headlines with their flags, Sleeper's trending lists
          and one betting line per game (the closing line from the summary wins over earlier scoreboards).
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Crosswalks (ADR 0005).</strong> <a href={m('team_xwalk')} class={link}>Teams</a> match ESPN to the league
            by full name, then nickname from the team seed, then abbreviation.{' '}
            <a href={m('game_xwalk')} class={link}>Games</a> match on the same two teams and the same Eastern date (the next
            or previous day when none), each ESPN game used once. <a href={m('player_xwalk')} class={link}>Players</a> match by
            the override seed first; then by exact name (either order, nickname, first and last) on the same team in a
            matched game; then by fuzzy name similarity, where a matching birth date lowers the bar; keeping mutual best
            matches. The rest wait in <a href={m('player_xwalk_review')} class={link}>player_xwalk_review</a>.
          </li>
          <li>
            <strong>Reconciliation.</strong> <a href={m('player_game_reconciliation')} class={link}>Each player-game</a> gets
            one verdict across twelve counts and minutes: exact (counts agree, minutes within half a minute, or neither
            source has the player playing), minor (counts agree, minutes within one), or conflict. Each differing value is a
            row in <a href={m('reconciliation')} class={link}>ops.reconciliation</a>, and the league's figure wins unless it
            is missing.
          </li>
          <li>
            <strong>Players on the floor.</strong> <a href={m('event_lineups')} class={link}>event_lineups</a> puts five
            players a side on the floor for every play-by-play action. Substitutions name only the player leaving; the one
            coming on is matched to the box score by five ranked name rules (given-name prefixes, suffixes, changed names,
            reversed names, the last word of a longer name). Events are ordered by game clock; period starters come from the
            box score in the first period and are inferred after it.
          </li>
        </ul>

        <h3 id="gold" class="mt-4 font-semibold">Gold</h3>
        <p class="mt-1">
          {count('gold')} models: {dims.length} dimensions, {facts.length} facts and {marts.length} marts;{' '}
          {list(incrementalGold.map((g) => g.name))} are incremental merges, the rest are rebuilt every run.{' '}
          <a href={m('dim_player')} class={link}>Players</a> carry their team history as stints from where they actually
          played (ADR 0003); teams, games and dates complete the dimensions.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Games:</strong> <a href={m('fct_player_game')} class={link}>fct_player_game</a>,{' '}
            <a href={m('fct_team_game')} class={link}>fct_team_game</a>, <a href={m('fct_event')} class={link}>fct_event</a>{' '}
            (every action with the players on the floor), <a href={m('fct_shot')} class={link}>fct_shot</a> and{' '}
            <a href={m('fct_game_line')} class={link}>fct_game_line</a> (the closing line of every played game).
          </li>
          <li>
            <strong>Availability:</strong> <a href={m('fct_availability')} class={link}>fct_availability</a> (ESPN's
            listings, linked to players by name within the team), <a href={m('fct_injury_status')} class={link}>fct_injury_status</a>{' '}
            (each run of the same status over time) and <a href={m('fct_player_status')} class={link}>fct_player_status</a>:
            one current status per player, the official report's for the next game it covers, otherwise ESPN's.
          </li>
          <li>
            <strong>Role and moves:</strong> <a href={m('fct_starting_lineup')} class={link}>fct_starting_lineup</a> (starter,
            bench or inactive in the next game day, NBA only), <a href={m('fct_transaction')} class={link}>fct_transaction</a>{' '}
            and <a href={m('fct_player_news')} class={link}>fct_player_news</a> (headlines tagged with the player and at most
            three others, each with one flag: out for season, surgery, minutes limit, return, injury, G League or role).
          </li>
          <li>
            <strong>Market and context:</strong> <a href={m('fct_market_value')} class={link}>fct_market_value</a> (market
            rank by average draft position, an ownership bucket and a rising or falling trend),{' '}
            <a href={m('fct_waiver_trend')} class={link}>fct_waiver_trend</a> (Sleeper's adds and drops, linked by name, birth
            date and team), <a href={m('fct_team_stakes')} class={link}>fct_team_stakes</a> (eliminated, clinched or racing,
            and a rest risk late in the season for a team with nothing to play for) and{' '}
            <a href={m('fct_team_game_context')} class={link}>fct_team_game_context</a> (rest days, back-to-backs, three
            games in four nights, miles travelled, time zones crossed and altitude, placed by the venues seed).
          </li>
          <li>
            <strong>The ledger:</strong> <a href={m('fct_board_history')} class={link}>fct_board_history</a> keeps one row per
            Eastern date, league and player with the projection, the value, availability and the signals beside it. A later
            build the same day replaces that day's rows, and the model is set never to be rebuilt by a full refresh, so the
            newer signals gain the history a backtest needs.
          </li>
        </ul>
        <p class="mt-2">The marts:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>Category z-scores</strong> (<a href={m('mart_category_zscores')} class={link}>mart_category_zscores</a>)
            for each season and the last 10 and 20 games, against the 180 NBA or 90 WNBA players with the most minutes in the
            window: per-game counting stats, turnovers negative, percentages volume-weighted as (player % − pool %) ×
            attempts per game. <a href={m('mart_player_rolling')} class={link}>mart_player_rolling</a> keeps 5, 10 and
            20-game averages.
          </li>
          <li>
            <strong>Projection and value</strong> (<a href={m('mart_player_projection')} class={link}>mart_player_projection</a>,{' '}
            <a href={m('mart_board')} class={link}>mart_board</a>), as the <a href="#value" class={link}>activity diagram</a>{' '}
            shows: production per minute (minutes × {f.fantasy_recency.join(', ')} by season), minutes per game (games ×{' '}
            {nba.minutes_recency.join(', ')} in the NBA, {wnba.minutes_recency.join(', ')} in the WNBA; a past season on
            another team counts {f.fantasy_team_change} of its minutes, since the role was another team's, while per-minute
            production carries over; in season, with five or more games for the current team, half that figure and half the
            player's last five games, so a change of role shows at once), {nba.prior_games} or {wnba.prior_games} games of a
            replacement-level player, two scoring passes over a {nba.teams}×{nba.roster_spots} or {wnba.teams}×{wnba.roster_spots}{' '}
            league's pool, replacement level subtracted, then value above replacement times the games share. Values below
            replacement are never scaled.
          </li>
          <li>
            <strong>Availability.</strong> The status shown is the official report's for the next game, otherwise ESPN's. The
            rest-of-season multiplier reads ESPN's listing and expected return, because the official report speaks only to
            the next game: out with a return date counts the team's games before that date, out with no date all remaining
            games; doubtful counts 0.75 of a game, questionable 0.5, day-to-day 0.25. Once the regular season is over, rest
            of season is the value itself.
          </li>
          <li>
            <strong>Streamers</strong> (<a href={m('mart_streamers')} class={link}>mart_streamers</a>) compare each current
            player's last five games (minutes) and last ten (value) with the player's earlier games blended with the latest
            earlier season, and carry the board rank, games this fantasy week (Monday to Sunday) and next seven days, the
            lineup role and its date, ownership and its trend, the headline flag, team stakes and Sleeper's adds and drops.
          </li>
          <li>
            <strong>The schedule</strong> (<a href={m('mart_schedule_upcoming')} class={link}>mart_schedule_upcoming</a>)
            covers the next fourteen days. Each side of a game has a small matchup value from the opponent's defensive rating
            and the expected pace, both blending this season to date with last season (counting as{' '}
            {f.fantasy_matchup.prior_games} games) and standardised over the league; beside it are the betting line (spread,
            total, each side's implied points) and each team's rest, travel and altitude.
          </li>
          <li>
            <strong>Settings chosen by backtest</strong> (ADR 0003), replaying WNBA 2021 to 2026 and NBA 2024-25 and 2025-26
            from checkpoints before and during each season (before it, and a twentieth, a tenth, a quarter and half way in;
            every 14 days for minutes). Adopted: per-minute production with minutes and games played projected apart, the
            team-change weight, the matchup weights, and the in-season minutes blend, which cut the error in next-ten-game
            minutes from 3.98 to 3.44 in the NBA and from 3.92 to 3.30 in the WNBA. Tested and left out: counting the
            current season for more early on, dropping games cut short, the team-change weight on production, a player's
            past results against an opponent, and the opponent's defence against the player's position, which explained
            nothing beyond overall defence. Lines, rest and travel, headline flags and the market are shown only, until a
            backtest says they add to the value.
          </li>
        </ul>

        <h3 id="ops" class="mt-4 font-semibold">Ops</h3>
        <p class="mt-1">
          {count('ops')} dbt models: the ingest run log (read straight from the landing run logs), every reconciliation
          difference, match and conflict rates per league and season (printed in every build log), and{' '}
          <a href={m('feed_freshness')} class={link}>feed_freshness</a>: each feed's newest landing day against the age it
          may reach while the league is playing. The gate script writes two more tables: <code>test_results</code> and{' '}
          <code>publish_gate</code>. Data Health shows the gate, the checks, the latest 100 ingest runs, the reconciliation
          rates and every feed.
        </p>
      </section>

      <section id="gate">
        <h2 class="text-lg font-semibold tracking-tight">3. Gate</h2>
        <p class="mt-2">
          dbt builds and tests together, layer by layer, so a failing test skips the models downstream of it. The build runs{' '}
          {schema.generic_tests} column tests (keys, not null, relationships, accepted values), all blocking,{' '}
          {unitTests.length} dbt unit tests that pin logic on hand-made rows, and {checks.length}{' '}
          <a href={href('/schema/#checks')} class={link}>data-quality checks</a>.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            <strong>{errorChecks.length} blocking:</strong>{' '}
            {errorChecks.map((c, i) => (
              <>
                {i > 0 && ', '}<a href={href(`/schema/#check-${c.name}`)} class={link}><code>{c.name}</code></a>
              </>
            ))}. The last fails only in a chaos drill, to prove the gate and the incident path.
          </li>
          <li>
            <strong>{warnChecks.length} warnings</strong>, reported and never blocking:{' '}
            {warnChecks.map((c, i) => (
              <>
                {i > 0 && ', '}<a href={href(`/schema/#check-${c.name}`)} class={link}><code>{c.name}</code></a>
              </>
            ))}. Two cover injury links: <code>warn_injury_links</code> for ESPN's listing and{' '}
            <code>warn_official_injury_links</code> for the official report.
          </li>
        </ul>
        <p class="mt-2">
          The gate script records every model and test result and closes the gate on any blocking failure or model error;
          then nothing is exported and the previous build keeps serving. A missed game blocks the gate only once it has been
          final for more than a day, so one failed request does not. The build's incident issue covers every step from dbt
          to the export, notebooks, extract, promotion and sheet push: it names the steps that failed, carries the end of
          the job log with sample failing rows, is commented on while it recurs and closes itself only when every step that
          ran succeeded. CI runs the column and unit tests on every change; the data-quality checks need real data and run
          only in the builds on Databricks.
        </p>
      </section>

      <section id="export">
        <h2 class="text-lg font-semibold tracking-tight">4. Export</h2>
        <p class="mt-2">
          A passing build is read from the warehouse as Arrow (ADR 0006) and written to R2 as <code>builds/&lt;id&gt;/</code>:
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            Parquet for every gold and ops table, the gate's two tables and the category seed, except{' '}
            {notExported.map((n, i) => (
              <>
                {i > 0 && ', '}<code>{n.name}</code>
              </>
            ))}, which the board and Streamers carry instead. {list(partitioned.map((p) => p.name))} are split into one file
            per league and season.
          </li>
          <li>
            JSON for the pages: per league the board, streamers, schedule and the newest 150 transactions, rounded to four
            decimals; the dimensions, availability, current statuses, team stakes, reconciliation rates, run log, feed
            freshness, the gate and the categories.
          </li>
          <li>
            One file per player (<code>players/&lt;league&gt;/&lt;id&gt;.json</code>) with stints, season lines, game log,
            rolling averages, z-scores, the board row, shots, moves, the newest eight headlines and the injury history.
          </li>
          <li>
            <code>health.json</code> for Data Health: data as of, the gate and its history, the latest checks, the latest 100
            ingest runs, reconciliation rates, row counts and every feed's freshness.
          </li>
          <li>
            <code>manifest.json</code>, with each file's size, rows and SHA-256, and <code>keys.txt</code>, every key the
            build wrote, which pruning reads to delete the build later.
          </li>
        </ul>
        <p class="mt-2">The build is staged: nothing points at it until stage 6.</p>
      </section>

      <section id="analysis">
        <h2 class="text-lg font-semibold tracking-tight">5. Analyse</h2>
        <p class="mt-2">
          The analysis notebooks are executed against every staged build. A GitHub runner reads the build by id over HTTPS,
          with the CI reader key the private Parquet needs, and adds the rendered pages and their findings to the build;
          they are published at <a href={href('/notebooks/')} class={link}>/notebooks/</a>. The Tableau extract reads the
          same build and adds its CSV files. If either fails, the build is promoted without it and the incident names the
          step. A manual workflow, Run the notebooks, executes a branch's notebooks against the published build, prints
          their findings and publishes nothing.
        </p>
        <p class="mt-2">
          After promotion the extract is also written to a Google Sheet, one tab per file (the step skips itself until the
          sheet and its service account are configured). Tableau Public refreshes a Sheets source daily, which is how the
          League Pulse workbook on the <a href={href('/dashboards/')} class={link}>Dashboards</a> page stays current once it
          is published.
        </p>
      </section>

      <section id="promote">
        <h2 class="text-lg font-semibold tracking-tight">6. Promote</h2>
        <p class="mt-2">
          Promotion writes <code>builds.json</code> and then <code>latest.json</code>, so the live build is always complete,
          and prunes old builds: seven are kept, about three and a half days at two passing builds a day, and the build{' '}
          <code>latest.json</code> points at is never deleted. A rollback (Export data workflow) points{' '}
          <code>latest.json</code> at an earlier build and pins it: new builds are still recorded but do not go live until
          the pin is released. A build exported by hand checks the latest publish gate first and follows the same stage,
          analyse and promote path.
        </p>
      </section>

      <section id="serving">
        <h2 class="text-lg font-semibold tracking-tight">7. Serve</h2>
        <p class="mt-2">
          A Cloudflare Worker serves this static Astro site and, under <code>/data/</code>, the R2 bucket with range requests.
          The pointers are cached for a minute (<code>public, max-age=60</code>); every build file is cached for a year as
          immutable, privately for Parquet. Player pages <code>/p/&lt;league&gt;/&lt;id&gt;/</code> are rewritten to one page. The content security
          policy allows inline code only by hash, WebAssembly for DuckDB, DuckDB's extension host and the Tableau embed;
          the dbt docs and the rendered notebooks have their own policies.
        </p>
        <p class="mt-2">
          The pages read the build's JSON in the browser; the Schema and Pipeline pages are built from the project instead.
          The Parquet files are private (ADR 0008): the Worker serves them only to the owner, signed in with Yahoo OpenID
          (the account must match a configured id, and the session is an HMAC-signed cookie), and to CI, which sends a key
          derived from the Yahoo client secret. Anyone else gets a 401, so the SQL console, which loads DuckDB-WASM from R2
          and reads the Parquet by range, is the owner's tool. The Yahoo routes are the owner's sign-in, its callback, sign
          out and status; the league import (ADR 0007) shares the callback and stays parked until the{' '}
          <code>YAHOO_IMPORT</code> variable turns it on.
        </p>
        <p class="mt-2">
          The site deploys when its code changes, never when data does: production from <code>main</code>, a preview Worker
          from <code>preprod</code> reading the same bucket. The deploy builds the site, generates the dbt docs from the
          sample at <code>/docs/</code>, copies DuckDB-WASM into R2 (too large for static assets), deploys the Worker with
          the Yahoo credentials as secrets, runs a smoke test (the home page, the docs, the pointer and the Yahoo status
          route) and then Lighthouse three times on the home page, holding the median LCP under 2 s.
        </p>
      </section>
    </div>

    <section id="workflows" class="mt-10 max-w-3xl text-sm leading-relaxed" data-testid="other-workflows">
      <h2 class="text-lg font-semibold tracking-tight">Other workflows</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li>
          <strong>CI</strong>, on every pull request and every push to <code>main</code> and <code>preprod</code>: a secret
          scan and a parse of every workflow file; ruff, mypy and pytest; a check that the dbt sample matches the recorded
          fixtures; the sample built twice on DuckDB (the second run takes the incremental path) with the unit tests and the
          gate; the schema file current, with every column described; a chaos drill that must close the gate; the notebooks
          and the extract on the sample; page tests on desktop and phone with accessibility and phone-width checks; Worker
          tests and a dry-run deploy.
        </li>
        <li>
          <strong>Probe sources</strong>, by hand and on pull requests that change the ingest: from a GitHub runner, checks
          that the stats API, ESPN's site and fantasy APIs, the injury-report index and PDFs, the lineups and movement files,
          Sleeper and the league's CDN answer, and Databricks when its credentials are set. It reports and never fails.
        </li>
        <li>
          <strong>Backfill:</strong> whole seasons per league, one season and season type at a time, on the same runners and
          client as Ingest, with the faster backfill pace and shot charts per team and season. A build follows each run.
        </li>
        <li><strong>Export data:</strong> build (after checking the latest gate), roll back (pinning), unpin, or list builds.</li>
        <li><strong>Run the notebooks:</strong> a branch's notebooks against the published build; findings in the log, pages as a three-day artefact.</li>
        <li><strong>Query the lakehouse:</strong> read-only; prints any table, filtered and ordered, into the job log.</li>
        <li><strong>Databricks job:</strong> after each successful dbt job, the bundle job deploys a scheduled Databricks job of the same dbt project, kept paused.</li>
      </ul>
    </section>
  </section>
</Base>
