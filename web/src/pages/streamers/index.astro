---
import Streamers from '../../components/Streamers';
import Base from '../../layouts/Base.astro';
---

<Base
  preload={['streamers/{league}.columns.json', 'schedule/{league}.json', 'dim_team.json', 'transactions/{league}.json', 'team_weeks/{league}.json']}
  title="Pickups"
  description="The best free agents to pick up this week: games left, matchups, minutes and value trending up, and the categories you need."
>
  <section>
    <h1 class="title-page">Pickups</h1>
    <p class="mt-1 text-sm text-muted">
      The players worth adding for the days ahead: games left, matchups, and minutes and value climbing against each
      player's baseline.
    </p>
    <!-- a screen tall while the island loads, so the footer starts below the fold and nothing shifts (#436) -->
    <div class="mt-6 min-h-screen">
      <Streamers client:only="react" />
    </div>
  </section>
</Base>
