---
import TradeAnalyzer from '../../components/TradeAnalyzer';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Trade"
  description="Evaluate a trade: what each side is worth for the rest of the season under your league's scoring, how your team changes category by category, and a verdict."
>
  <section>
    <h1 class="title-page">Trade</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Build a trade, find one across your league, or start from the players your build values differently from everyone
      else.
    </p>
    <div class="mt-6">
      <TradeAnalyzer client:only="react" />
    </div>
  </section>
</Base>
