---
import LeagueSetup from '../../components/LeagueSetup';
import Base from '../../layouts/Base.astro';
---

<Base
  title="League"
  description="Set up your fantasy league: its size, scoring and punts, the teams in draft order and every roster, imported from Yahoo or added by hand."
>
  <section>
    <h1 class="title-page">League</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Your league as every page sees it: its size and scoring set what a player is worth, and its rosters set who is
      still available.
    </p>
    <div class="mt-6">
      <LeagueSetup client:only="react" />
    </div>
  </section>
</Base>
