---
import MyTeam from '../../components/MyTeam';
import Base from '../../layouts/Base.astro';
---

<Base
  title="My Team"
  description="Your fantasy team at a glance: this week's matchup, who plays today, your chance of winning each category against the league, your roster's value and form, and the moves worth making."
>
  <section>
    <h1 class="title-page">My Team</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Your week, your categories against the league, your roster and the moves worth making, under your league's
      scoring.
    </p>
    <div class="mt-6 min-h-screen">
      <MyTeam client:only="react" />
    </div>
  </section>
</Base>
