---
import Diagram from '../../components/Diagram.astro';
import Base from '../../layouts/Base.astro';
import { erAreas, erCaption, schemaDiagrams } from '../../lib/schema-diagrams';
import {
  checks,
  checksHref,
  conventions,
  count,
  coverage,
  described,
  genericTests,
  landing,
  layers,
  list,
  models,
  pageHref,
  rowId,
  seeds,
  sources,
  summary,
  unitTests,
  unitTestsHref,
  type Entry,
} from '../../lib/schema-page';
import { href } from '../../lib/site';

const layerOf = new Map(models.map((m) => [m.name, m.layer]));
const columnCount = models.reduce((n, m) => n + m.columns.length, 0);
const describedCount = models.reduce((n, m) => n + described(m.columns), 0);
const errorChecks = checks.filter((c) => c.severity === 'error').length;
const seedEntries: Entry[] = seeds.map((s) => ({ ...s, kind: 'seed' as const }));

const bronze = layers.find((l) => l.name === 'bronze')?.models ?? [];
const sharedEndpoints = landing.filter((f) => f.read_by.length > 1 && f.read_by.every((m) => layerOf.get(m) === 'bronze'));
const bronzeEndpoints = landing.filter((f) => f.read_by.some((m) => layerOf.get(m) === 'bronze'));
const unpublished = (layers.find((l) => l.name === 'gold')?.models ?? []).filter((m) => !m.exported_as.length).map((m) => m.name);

const LAYER_ABOUT: Record<string, string> = {
  bronze: `The landed JSON as rows: ${bronze.length} incremental models over ${bronzeEndpoints.length} landing folders, one model per kind of row a payload holds (${list(
    sharedEndpoints.map((f) => `${f.path} feeds ${count(f.read_by.length)}`),
  )}). Each appends only the files not loaded before, and every row carries the file it came from and the day it landed. Values stay text until silver.`,
  silver:
    'Typed, deduplicated and keyed (the latest landing wins), with the cross-source work: team, game and player crosswalks, the reconciliation of the two box scores, and lineups from substitutions.',
  gold: `The star schema the app, the notebooks and the dashboards read: dimensions, facts, and the fantasy marts (z-scores, the projection, the board, streamers). Every gold model goes out whole in each published build${
    unpublished.length ? ` except ${list(unpublished)}, which reaches the site through the marts that read it` : ''
  }; "Published as" on a model's page names the files of a build that carry it.`,
  ops: 'How the pipeline is doing: the ingest run log and the reconciliation of the two sources. The build adds test_results and publish_gate after every run.',
};

// The fixture build runs on DuckDB, so the types below are DuckDB's; production runs on Databricks.
const DATABRICKS: Record<string, string> = {
  varchar: 'string',
  integer: 'int',
  hugeint: 'bigint',
  ubigint: 'int',
  'timestamp with time zone': 'timestamp',
};
const WHY: Record<string, string> = {
  hugeint: 'DuckDB widens a sum of integers to 128 bits',
  ubigint: 'a JSON array length',
  'timestamp with time zone': 'both hold an instant',
};
const typesUsed = [...new Set([...models.flatMap((m) => m.columns), ...seeds.flatMap((s) => s.columns)].map((c) => c.type).filter(Boolean))].sort();
const typeRows = typesUsed.filter((t) => DATABRICKS[t]).map((t) => ({ duck: t, databricks: DATABRICKS[t]!, why: WHY[t] ?? '' }));
const sameTypes = typesUsed.filter((t) => !DATABRICKS[t]);

// The diagrams are files the page loads as they near the viewport; the page keeps only their size (#449).
const areas = erAreas();
const svgs = await schemaDiagrams();
const diagramSrc = (id: string) => href(`/schema/diagrams/${id}.svg`);
const link = 'underline underline-offset-4';
const pill = 'rounded-full border border-line px-3 py-1 hover:bg-card';
// The rows' look is set once on their list ("*:" styles each child), not repeated on every row (#449).
const rows = 'mt-3 grid grid-cols-[minmax(0,1fr)] gap-2 *:min-w-0 *:rounded-lg *:border *:border-line *:bg-card *:px-4 *:py-2 *:target:border-accent';
---

<Base
  title="Schema"
  description="Every model in the lakehouse by layer: what it holds, its grain, how it is computed, its columns with types and tests, what it reads and which published files carry it."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Schema</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Every model in the lakehouse, generated from the dbt project: {models.length} models in {count(layers.length)} layers ({
        list(layers.map((l) => l.name))
      }) over {landing.length} landing folders, {columnCount} columns ({describedCount} described), {genericTests} column
      tests, {unitTests.length} unit tests and {checks.length} data-quality checks. Each model has its own page with its
      columns and its notes, the comment at the top of its SQL where the method is written down. CI fails when this page falls
      behind the project. The gold layer is drawn by subject area below, every model's <a href="#lineage" class={link}>lineage</a>
      follows, and how the layers fit together is on the <a href={href('/pipeline/')} class={link}>Pipeline</a> page.
    </p>
    <dl class="mt-3 grid max-w-3xl gap-1 text-sm" data-testid="conventions">
      <dt class="text-xs font-medium tracking-wide text-muted uppercase">Column conventions</dt>
      {conventions.map((c) => (
        <dd class="text-muted">
          <span class="font-medium">{c.name}:</span> <Fragment set:html={c.rule.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        </dd>
      ))}
    </dl>

    <nav class="mt-4 flex flex-wrap gap-2 text-sm" aria-label="Sections">
      <a href="#er" class={pill}>diagrams</a>
      {
        layers.map((l) => (
          <a href={`#${l.name}`} class={pill}>
            {l.name} · {l.models.length}
          </a>
        ))
      }
      <a href="#seeds" class={pill}>seeds · {seeds.length}</a>
      <a href={checksHref} class={pill}>checks · {checks.length}</a>
      <a href={unitTestsHref} class={pill}>unit tests · {unitTests.length}</a>
    </nav>

    <section id="types" class="mt-6 max-w-3xl rounded-lg border border-line bg-card px-4 py-3 text-sm" aria-labelledby="types-title">
      <h2 id="types-title" class="font-semibold">Column types are DuckDB's</h2>
      <p class="mt-1 text-muted">
        The types are read from the catalog of the fixture build, which runs on DuckDB; the lakehouse runs the same SQL on
        Databricks. These differ there; the rest ({sameTypes.join(', ')}) are the same on both, though a computed decimal
        can carry a different precision.
      </p>
      <div class="table-scroll mt-2 overflow-auto rounded border border-line" tabindex="0" role="region" aria-label="DuckDB types and their Databricks equivalents">
        <table class="w-full text-xs">
          <thead class="bg-bg text-left text-muted">
            <tr>
              <th class="px-2 py-1 font-medium">DuckDB</th>
              <th class="px-2 py-1 font-medium">Databricks</th>
              <th class="px-2 py-1 font-medium">Why they differ</th>
            </tr>
          </thead>
          <tbody>
            {
              typeRows.map((t) => (
                <tr class="border-t border-line">
                  <td class="px-2 py-1 font-mono whitespace-nowrap">{t.duck}</td>
                  <td class="px-2 py-1 font-mono whitespace-nowrap">{t.databricks}</td>
                  <td class="px-2 py-1">{t.why || 'another name for the same type'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="er" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">Gold entity-relationship diagrams</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">
        What the app, the notebooks and the dashboards read, by subject area: facts, dimensions and marts (each header names its
        kind and has its own colour), with primary keys, foreign keys and natural keys. Every entity links to its row below.
      </p>
      {
        areas.map((a) => (
          <section id={a.id} class="mt-6" aria-labelledby={`${a.id}-heading`}>
            <h3 id={`${a.id}-heading`} class="font-semibold">
              {a.title}
            </h3>
            <p class="mt-1 max-w-3xl text-sm text-muted">{a.about}</p>
            <Diagram
              id={a.id}
              svg={svgs.get(a.id) ?? ''}
              src={diagramSrc(a.id)}
              title={`${a.title}: entity-relationship diagram`}
              caption={erCaption(a)}
            />
          </section>
        ))
      }
    </section>

    <section id="lineage" class="mt-8">
      <h2 class="text-lg font-semibold tracking-tight">Lineage</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">
        Every model and what it is built from, left to right: the landing folders the ingestors write (each bronze model reads
        one through <code class="font-mono">landing_files(source, endpoint)</code>), the seeds, then bronze, silver, gold and ops.
        Each box links to the model's row below.
      </p>
      <Diagram
        id="lineage"
        svg={svgs.get('lineage') ?? ''}
        src={diagramSrc('lineage')}
        title="Model lineage by layer"
        caption="Arrows point from a folder or model to the models built from it. Generated from the dbt project on every change."
      />
    </section>

    <div
      id="models"
      class="mt-8 grid gap-1 rounded-lg border border-line bg-card px-4 py-3"
      data-schema-tools
      data-schema-columns={href('/schema/columns.json')}
      hidden
    >
      <label class="grid min-w-0 gap-1 text-sm">
        <span class="text-muted">Filter models and columns</span>
        <input
          type="search"
          class="w-full rounded border border-line bg-bg px-2 py-1 font-mono text-sm"
          placeholder="e.g. player_sk or mart_"
          autocomplete="off"
          spellcheck="false"
          data-schema-filter
        />
      </label>
      <p class="text-xs text-muted" role="status" aria-live="polite" data-schema-status></p>
    </div>

    {
      layers.map((l) => (
        <section id={l.name} class="mt-8" data-testid={`layer-${l.name}`} data-schema-group>
          <h2 class="text-lg font-semibold tracking-tight">{l.name}</h2>
          <p class="mt-1 max-w-3xl text-sm text-muted">{LAYER_ABOUT[l.name]}</p>
          {l.name === 'bronze' && (
            <div class="table-scroll mt-3 max-h-[60vh] overflow-auto" tabindex="0" role="region" aria-label="Bronze sources" data-testid="sources">
              <table class="w-full text-xs">
                <thead>
                  <tr class="text-left text-muted">
                    <th class="py-1 pr-3 font-medium">Source</th>
                    <th class="py-1 pr-3 font-medium">Host</th>
                    <th class="py-1 pr-3 font-medium">Ingest module</th>
                    <th class="py-1 pr-3 font-medium">Runner</th>
                    <th class="py-1 pr-3 font-medium">Cadence</th>
                    <th class="py-1 font-medium">Landing folders</th>
                  </tr>
                </thead>
                <tbody>
                  {sources.map((src) => (
                    <tr class="border-t border-line align-top">
                      <td class="py-1 pr-3 font-medium">{src.name}</td>
                      <td class="py-1 pr-3">{src.host}</td>
                      <td class="py-1 pr-3 font-mono">{src.module}</td>
                      <td class="py-1 pr-3">{src.runner}</td>
                      <td class="py-1 pr-3">{src.cadence}</td>
                      <td class="py-1 font-mono">{src.folders.join(', ')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <ul class={rows}>
            {models
              .filter((m) => m.layer === l.name)
              .map((m) => {
                const cover = coverage(m);
                return (
                  <li id={rowId(m.name)} data-testid="model" data-model={m.name}>
                    <a href={pageHref(m.name)} class={`font-mono text-sm font-medium wrap-anywhere ${link}`}>
                      {m.name}
                    </a>
                    <span class="ml-2 text-xs text-muted">{summary(m)}</span>
                    <span
                      class:list={['ml-2 inline-block rounded-full border px-2 text-xs', cover.full ? 'border-good text-good' : 'border-line text-muted']}
                      data-testid="coverage"
                    >
                      {cover.text}
                    </span>
                    {m.description && <span class="block text-sm text-muted">{m.description}</span>}
                  </li>
                );
              })}
          </ul>
        </section>
      ))
    }

    <section id="seeds" class="mt-8" data-schema-group>
      <h2 class="text-lg font-semibold tracking-tight">Seeds</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">Small reference tables kept in the repository and loaded by dbt.</p>
      <ul class={rows}>
        {
          seedEntries.map((s) => (
            <li id={rowId(s.name)} data-testid="seed" data-model={s.name}>
              <a href={pageHref(s.name)} class={`font-mono text-sm font-medium wrap-anywhere ${link}`}>
                {s.name}
              </a>
              <span class="ml-2 text-xs text-muted">{summary(s)}</span>
              {s.description && <span class="block text-sm text-muted">{s.description}</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <section id="checks" class="mt-8 max-w-3xl" data-testid="checks-summary">
      <h2 class="text-lg font-semibold tracking-tight">Checks and unit tests</h2>
      <p class="mt-1 text-sm text-muted">
        {checks.length} data-quality checks run on the real data after every build ({errorChecks} of them close the publish gate
        when they fail), and {unitTests.length} dbt unit tests pin a model's logic on hand-made rows on every pull request.
        Each is listed with what it holds on <a href={checksHref} class={link}>Checks and unit tests</a>.
      </p>
    </section>
  </section>
</Base>

<script>
  import { loadDiagramsNearView } from '../../lib/lazy-diagrams';

  // The checks and the unit tests have their own page (#935); a link kept from before follows them.
  if (/^#(check-|unit-tests$)/.test(location.hash)) location.replace(`checks/${location.hash}`);

  loadDiagramsNearView();

  // Filter the models and seeds by name or column. The rows carry only the names; the columns of
  // every model come from columns.json, fetched on the first search (#449). The list works
  // without this script; the filter appears only once it runs.
  const tools = document.querySelector<HTMLElement>('[data-schema-tools]');
  const input = document.querySelector<HTMLInputElement>('[data-schema-filter]');
  const status = document.querySelector<HTMLElement>('[data-schema-status]');
  const items = [...document.querySelectorAll<HTMLElement>('li[data-model]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-schema-group]')];
  const SHOWN_HITS = 8;
  let columns: Record<string, string[]> | null = null;
  let columnsState: 'idle' | 'loading' | 'failed' = 'idle';

  async function loadColumns(): Promise<void> {
    const src = tools?.dataset.schemaColumns;
    if (columnsState !== 'idle' || !src) return;
    columnsState = 'loading';
    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`${res.status}`);
      columns = (await res.json()) as Record<string, string[]>;
      columnsState = 'idle';
    } catch {
      columnsState = 'failed';
    }
    apply();
  }

  /** The line under a row that names the columns it matched by. */
  function showHits(item: HTMLElement, hits: string[]): void {
    let line = item.querySelector<HTMLElement>('[data-testid="column-hits"]');
    if (!hits.length) {
      line?.remove();
      return;
    }
    if (!line) {
      line = document.createElement('span');
      line.className = 'mt-1 block font-mono text-xs';
      line.dataset.testid = 'column-hits';
      item.append(line);
    }
    const more = hits.length > SHOWN_HITS ? ` and ${hits.length - SHOWN_HITS} more` : '';
    line.textContent = `${hits.length === 1 ? 'column' : 'columns'}: ${hits.slice(0, SHOWN_HITS).join(', ')}${more}`;
  }

  function apply(): void {
    const q = (input?.value ?? '').trim().toLowerCase();
    if (q && !columns) void loadColumns();
    let shownCount = 0;
    let byColumn = 0;
    for (const item of items) {
      const name = item.dataset.model ?? '';
      const nameHit = !q || name.toLowerCase().includes(q);
      const hits = q && !nameHit ? (columns?.[name] ?? []).filter((c) => c.toLowerCase().includes(q)) : [];
      const shown = nameHit || hits.length > 0;
      item.hidden = !shown;
      showHits(item, hits);
      if (shown) shownCount += 1;
      if (hits.length) byColumn += 1;
    }
    for (const g of groups) g.hidden = !g.querySelector('li[data-model]:not([hidden])');
    if (!status) return;
    if (!q) {
      status.textContent = '';
      return;
    }
    const note =
      columnsState === 'loading' ? '; looking through the columns' : columnsState === 'failed' ? '; the columns did not load, so only names are matched' : '';
    status.textContent = `${shownCount} of ${items.length} match${byColumn ? `, ${byColumn} by a column` : ''}${note}.`;
  }

  if (tools && input) {
    tools.hidden = false;
    input.addEventListener('input', apply);
    // A search typed before the script ran, or kept by the browser on going back.
    if (input.value) apply();
  }
</script>
