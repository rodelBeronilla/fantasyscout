---
/**
 * The data-quality checks and the dbt unit tests (#935): two long tables that were on the overview
 * at /schema/, on their own page so the overview's document stays small enough to arrive at once.
 */
import Base from '../../layouts/Base.astro';
import { checks, pageHref, unitTests } from '../../lib/schema-page';
import { href } from '../../lib/site';

const link = 'underline underline-offset-4';
---

<Base
  title="Checks and unit tests · Schema"
  description="Every data-quality check that runs on the real data after a build, with its severity and what it holds, and every dbt unit test with the case it pins down."
>
  <section>
    <p class="text-sm text-muted">
      <a href={href('/schema/')} class={link}>Schema</a>
      <span aria-hidden="true"> / </span>checks
    </p>
    <h1 class="mt-1 title-page">Checks and unit tests</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      {checks.length} <a href="#checks" class={link}>data-quality checks</a> on the real data and {unitTests.length}{' '}
      <a href="#unit-tests" class={link}>unit tests</a> on fixed rows. The column tests (keys, not null, relationships,
      accepted values) are on each model's page, from the <a href={href('/schema/')} class={link}>Schema</a> overview.
    </p>

    <section id="checks" class="mt-6" data-testid="checks-list">
      <h2 class="title-section">Data-quality checks</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">
        Checks run after every build on the real data. An error-severity failure closes the publish gate: nothing is exported
        and an incident issue opens with samples of the failing rows. A warning is recorded and shown on Data Health. Column
        tests (keys, not null, relationships, accepted values) run on every pull request as well.
      </p>
      <div class="mt-3 table-scroll max-h-[70vh] overflow-auto rounded-lg border border-line" tabindex="0" role="region" aria-label="Data-quality checks">
        <table class="w-full text-sm">
          <thead class="bg-card text-left text-muted">
            <tr>
              <th class="px-3 py-2 font-medium">Check</th>
              <th class="px-3 py-2 font-medium">Severity</th>
              <th class="px-3 py-2 font-medium">What it holds</th>
              <th class="px-3 py-2 font-medium">Reads</th>
            </tr>
          </thead>
          <tbody>
            {
              checks.map((c) => (
                <tr id={`check-${c.name}`} class="border-t border-line align-top">
                  <td class="px-3 py-2 font-mono text-xs whitespace-nowrap">{c.name}</td>
                  <td class:list={['px-3 py-2', c.severity === 'error' ? 'text-bad' : 'text-warn']}>{c.severity}</td>
                  <td class="px-3 py-2">{c.about}</td>
                  <td class="px-3 py-2 font-mono text-xs">{c.reads.join(', ')}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="unit-tests" class="mt-8" data-testid="unit-tests-list">
      <h2 class="title-section">Unit tests</h2>
      <p class="mt-1 max-w-3xl text-sm text-muted">
        dbt unit tests run a model's SQL on fixed input rows and compare the result with the rows expected, on every pull
        request, so a rule that is easy to break (a ranking, a rest-day count, a name link) is pinned down with a worked case.
      </p>
      <div class="mt-3 table-scroll max-h-[70vh] overflow-auto rounded-lg border border-line" tabindex="0" role="region" aria-label="Unit tests">
        <table class="w-full text-sm">
          <thead class="bg-card text-left text-muted">
            <tr>
              <th class="px-3 py-2 font-medium">Unit test</th>
              <th class="px-3 py-2 font-medium">Model</th>
              <th class="px-3 py-2 font-medium">The case it pins down</th>
            </tr>
          </thead>
          <tbody>
            {
              unitTests.map((u) => (
                <tr class="border-t border-line align-top">
                  <td class="px-3 py-2 font-mono text-xs">{u.name}</td>
                  <td class="px-3 py-2 font-mono text-xs">
                    <a href={pageHref(u.model)} class={link}>
                      {u.model}
                    </a>
                  </td>
                  <td class="px-3 py-2">{u.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </section>
</Base>
