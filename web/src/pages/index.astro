---
import Board from '../components/Board';
import Base from '../layouts/Base.astro';
---

<Base
  title="Board"
  description="Ranked WNBA and NBA players by category z-score, with punt toggles, availability adjustment and filters by team and position."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Board</h1>
    <p class="mt-1 text-sm text-muted">
      Players ranked by blended category z-scores: the current season weighs more as it goes on, the two
      before it fill in the rest. Punt a category to drop it from the total; the adjustment scales by games
      left and availability.
    </p>
    <div class="mt-6">
      <Board client:load />
    </div>
  </section>
</Base>
