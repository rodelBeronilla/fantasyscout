---
import Board from '../components/Board';
import Base from '../layouts/Base.astro';
---

<Base
  preload={['board/{league}.columns.json']}
  title="Board"
  description="WNBA and NBA players ranked by value above replacement in your league, with tiers, who is still available, punts and filters."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Board</h1>
    <!-- shown on a phone too: it is the page's largest early paint, and hiding it moved the LCP to
         what React renders later, over the budget (#704) -->
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Every player ranked by value above a replacement-level pickup in your league, under its size and scoring, from a
      projected per-game line.
    </p>
    <!-- a screen tall while the island loads, so the footer starts below the fold and nothing shifts (#436) -->
    <div class="mt-6 min-h-screen">
      <Board client:only="react" />
    </div>
  </section>
</Base>
