---
import Board from '../components/Board';
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base
  title="Board"
  description="WNBA and NBA players ranked by value above replacement in your league, with tiers, who is still available, punts and filters."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Board</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted">
      Players ranked by value above replacement in your league, scored on a projected per-game line and counted over
      the games each player is projected to play. Set up your league's size, scoring and rosters on the
      <a href={href('/league/')} class="underline underline-offset-4">League page</a> to see who is still available and what
      your team needs.
    </p>
    <div class="mt-6">
      <Board client:only="react" />
    </div>
  </section>
</Base>
