---
import Base from '../../layouts/Base.astro';
import { ADR_FILES } from '../../generated/features';
import { PARAMETERS } from '../../generated/parameters';
import { href, REPO_URL } from '../../lib/site';
import { SHOWN_LABEL, VERDICT_LABEL, VERDICTS, verdictRows, type Verdict } from '../../lib/verdicts';

// Every number the models and the calls use, from methodology/parameters.yml (#765). The page is
// built from the generated module, so it cannot drift from what the site runs on.
type Value = number | string | readonly Value[] | { readonly [k: string]: Value };
const show = (v: Value): string => {
  if (Array.isArray(v)) return v.map(show).join(', ');
  if (v !== null && typeof v === 'object') {
    return Object.entries(v)
      .map(([k, x]) => (typeof x === 'object' ? `${k}: (${show(x)})` : `${k}: ${show(x)}`))
      .join('; ');
  }
  return String(v);
};

const AREAS: [string, string][] = [
  ['scale', 'The value scale'],
  ['projection', 'The projection'],
  ['matchup', 'Matchups'],
  ['standings', 'The standings model'],
  ['playoffs', 'Playoff odds and the playoff weeks'],
  ['fit', 'Fit'],
  ['sync', 'Keeping the league current'],
  ['notes', 'The player notes'],
  ['trade', 'Trade verdicts and suggestions'],
  ['roster', 'Roster review'],
  ['buysell', 'Buy low, sell high'],
  ['il', 'Injured-list moves'],
  ['injury', 'Injury histories'],
  ['blowout', 'Blowout risk'],
  ['auction', 'Auction values'],
  ['backtest', 'How the backtests judge'],
];
const STATUS_HELP: Record<string, string> = {
  measured: 'fitted or backtested on data',
  assumed: 'chosen without a measurement, waiting for its backtest',
  convention: 'a platform default, not a model choice',
  arithmetic: 'derived from the schedule or the definitions',
};
const area = (id: string) => id.split('.')[0];
const groups = AREAS.map(([key, label]) => ({ key, label, params: PARAMETERS.filter((p) => area(p.id) === key) })).filter((g) => g.params.length);
const count = (status: string) => PARAMETERS.filter((p) => p.status === status).length;
const link = 'underline underline-offset-4';

// The verdict table (#947): every feature from methodology/features.yml, whether it shows read from
// the site's switches (web/src/lib/visibility.ts).
const rows = verdictRows();
const tally = VERDICTS.map((v) => ({ v, n: rows.filter((r) => r.feature.verdict === v).length }));
const VERDICT_TONE: Record<Verdict, string> = { validated: 'text-good', failed: 'text-bad', open: 'text-warn', data: 'text-muted' };
const issueHref = (n: number) => `${REPO_URL}/issues/${n}`;
const adrHref = (n: number) => `${REPO_URL}/blob/main/docs/adr/${ADR_FILES[String(n)] ?? ''}`;
const pad = (n: number) => String(n).padStart(4, '0');
// on a phone each row stacks, each cell under its own label
const cell = 'px-2 py-1.5 align-top max-md:block max-md:px-0 max-md:py-0.5';
// page, verdict and whether it shows share one line on a phone
const inline = 'px-2 py-1.5 align-top max-md:inline max-md:px-0';
const label = 'font-medium text-muted md:hidden';
const dot = 'text-muted md:hidden';
---

<Base
  title="Methodology"
  description="What FantasyScout has validated out of sample, what failed and what waits to be judged, feature by feature, and every number the projections and calls use."
>
  <h1 class="title-page">Methodology: what passed, and every number</h1>
  <p class="mt-2 max-w-3xl text-sm text-muted">
    A call shows only once it has passed an out-of-sample check. A failed or unjudged call is hidden or badged, and the table says which and when it is next
    judged. Plain facts and arithmetic on them show as data. The table is built from{' '}
    <a href={`${REPO_URL}/blob/main/methodology/features.yml`} class={link} rel="noopener">methodology/features.yml</a> and the site's switches.
  </p>

  <section class="mt-5" aria-labelledby="verdicts-h">
    <h2 id="verdicts-h" class="label-caps">Every feature, and its verdict</h2>
    <p class="mt-1 text-sm" data-testid="verdict-counts">
      {tally.map(({ v, n }, i) => (
        <span data-verdict={v}>
          {i > 0 && ' · '}
          <span class={`font-medium ${VERDICT_TONE[v]}`}>{n}</span> {VERDICT_LABEL[v].toLowerCase()}
        </span>
      ))}
    </p>
    <table class="mt-2 w-full border-collapse text-sm max-md:block" data-testid="verdicts">
      <thead class="text-left text-xs text-muted max-md:hidden">
        <tr class="border-b border-line">
          <th scope="col" class="px-2 py-1.5 font-medium">What it is</th>
          <th scope="col" class="px-2 py-1.5 font-medium">Page</th>
          <th scope="col" class="px-2 py-1.5 font-medium">Verdict</th>
          <th scope="col" class="px-2 py-1.5 font-medium">On the site</th>
          <th scope="col" class="px-2 py-1.5 font-medium">ADR, issue</th>
          <th scope="col" class="px-2 py-1.5 font-medium">Next judged</th>
        </tr>
      </thead>
      <tbody class="max-md:block">
        {
          rows.map(({ feature: f, page, shown, numbers, next }) => (
            <tr class="border-b border-line max-md:block max-md:py-2" data-feature={f.id} data-verdict={f.verdict} data-shown={shown}>
              <td class={cell}>
                {f.what}
                {numbers && <span class="block text-xs text-muted">Numbers: {numbers}</span>}
              </td>
              <td class={inline}>
                {page.path ? (
                  <a href={href(page.path)} class={link}>
                    {page.label}
                  </a>
                ) : (
                  page.label
                )}
              </td>
              <td class={`${inline} font-medium ${VERDICT_TONE[f.verdict]}`}>
                <span class={dot}> · </span>
                {VERDICT_LABEL[f.verdict]}
              </td>
              <td class={inline}>
                <span class={dot}> · </span>
                {SHOWN_LABEL[shown]}
              </td>
              <td class={cell}>
                <span class={label}>Record: </span>
                {f.adr !== undefined && (
                  <a href={adrHref(f.adr)} class={link} rel="noopener">
                    ADR {pad(f.adr)}
                  </a>
                )}
                {f.adr !== undefined && f.issue !== undefined && ', '}
                {f.issue !== undefined && (
                  <a href={issueHref(f.issue)} class={link} rel="noopener">
                    #{f.issue}
                  </a>
                )}
              </td>
              <td class={cell}>
                <span class={label}>Next: </span>
                {next}
                {f.bar && (
                  <>
                    {' '}
                    (
                    <a href={f.bar} class={link} rel="noopener">
                      the bar
                    </a>
                    )
                  </>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <details class="mt-8" data-testid="registry">
    <summary class="cursor-pointer text-sm font-medium">Every number the models and calls use ({PARAMETERS.length}), and where it came from</summary>
    <p class="mt-2 max-w-3xl text-sm text-muted">
      Each number is registered with what it does, how it was set and the issue that will test it on seasons it has not seen. A number that fails its backtest
      is removed or reworked. The registry is{' '}
      <a href={`${REPO_URL}/blob/main/methodology/parameters.yml`} class={link} rel="noopener">methodology/parameters.yml</a>; the build fails on a number in a
      decision module that is not in it.
    </p>

    <section class="mt-6 max-w-3xl" aria-labelledby="status-h">
      <h2 id="status-h" class="label-caps">How each was set</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" data-testid="status-counts">
        {
          Object.entries(STATUS_HELP).map(([s, help]) => (
            <li data-status={s}>
              <span class="font-medium">{count(s)} {s}</span>: {help}
            </li>
          ))
        }
      </ul>
      <p class="mt-2 text-sm text-muted">
        The backtests follow the plan in <a href={`${REPO_URL}/issues/751`} class={link} rel="noopener">#751</a>: walk-forward on past seasons, with the latest
        season of each league held back and judged once, against a manager who goes by the season so far.
      </p>
    </section>

    <div class="mt-8 grid gap-8" data-testid="parameters">
      {
        groups.map((g) => (
          <section aria-labelledby={`${g.key}-h`} data-area={g.key}>
            <h2 id={`${g.key}-h`} class="label-caps">
              {g.label}
            </h2>
            <div class="mt-3 grid gap-3">
              {g.params.map((p) => (
                <article class="min-w-0 rounded-lg border border-line bg-card p-4" data-param={p.id} data-status={p.status}>
                  <h3 class="font-mono text-sm break-words">{p.id}</h3>
                  <p class="mt-1 text-sm">{p.what}</p>
                  <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[7rem_minmax(0,1fr)]">
                    <dt class="text-muted">Value</dt>
                    <dd class="font-mono break-words">{show(p.value as Value)}</dd>
                    <dt class="text-muted">Set by</dt>
                    <dd class={p.status === 'assumed' ? 'text-warn' : undefined}>{p.status}</dd>
                    <dt class="text-muted">Evidence</dt>
                    <dd class="break-words">{p.evidence}</dd>
                    <dt class="text-muted">Tested in</dt>
                    <dd>
                      <a href={`${REPO_URL}/issues/${p.validation}`} class={link} rel="noopener">
                        #{p.validation}
                      </a>
                    </dd>
                    {'dbt' in p && (
                      <>
                        <dt class="text-muted">dbt var</dt>
                        <dd class="font-mono break-words">{p.dbt}</dd>
                      </>
                    )}
                  </dl>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </details>
</Base>
