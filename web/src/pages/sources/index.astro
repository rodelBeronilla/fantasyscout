---
import Base from '../../layouts/Base.astro';
import sources from '../../lib/sources.json';

interface Source {
  name: string;
  host: string;
  terms: string;
  feeds: string;
  cadence: string;
  published: string;
  retention: string;
}
const list = sources.sources as Source[];
---

<Base title="Sources" description="Where FantasyScout's data comes from, what is published from each source, how often it is collected, how long it is kept, and how a source can object.">
  <h1 class="text-2xl font-semibold">Sources, terms and what is published</h1>
  <p class="mt-2 max-w-3xl text-sm text-muted">
    Every number on this site derives from a public feed of one of the organisations below. This page says what is taken from each, how often, what is published
    from it and how long it is kept. Last reviewed {sources.updated}.
  </p>

  <section class="mt-6 max-w-3xl" aria-labelledby="principles-h">
    <h2 id="principles-h" class="text-sm font-medium tracking-wide text-muted uppercase">What is and is not published</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" data-testid="principles">
      {sources.principles.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="mt-8" aria-labelledby="sources-h">
    <h2 id="sources-h" class="text-sm font-medium tracking-wide text-muted uppercase">Each source</h2>
    <div class="mt-3 grid gap-4" data-testid="sources">
      {
        list.map((s) => (
          <article class="rounded-lg border border-line bg-card p-4" data-source={s.name}>
            <h3 class="font-medium">
              {s.name} <span class="text-sm font-normal text-muted">({s.host})</span>
            </h3>
            <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[8rem_minmax(0,1fr)]">
              <dt class="text-muted">Feeds</dt>
              <dd>{s.feeds}</dd>
              <dt class="text-muted">Cadence</dt>
              <dd>{s.cadence}</dd>
              <dt class="text-muted">Published</dt>
              <dd>{s.published}</dd>
              <dt class="text-muted">Retention</dt>
              <dd>{s.retention}</dd>
              <dt class="text-muted">Terms</dt>
              <dd>
                <a href={s.terms} class="underline underline-offset-4" rel="noopener">
                  {s.terms}
                </a>
              </dd>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-8 max-w-3xl" aria-labelledby="retention-h">
    <h2 id="retention-h" class="text-sm font-medium tracking-wide text-muted uppercase">Retention and privacy</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" data-testid="retention">
      {sources.retention.map((r) => <li>{r}</li>)}
    </ul>
    <p class="mt-2 text-sm text-muted">
      The full statement, with where each store is and how long it keeps what, is in the repository's
      <a href="https://github.com/rodelBeronilla/fantasyscout/blob/main/docs/architecture.md#data-retention-and-privacy" class="underline underline-offset-4">architecture page</a>.
    </p>
  </section>

  <section class="mt-8 max-w-3xl" aria-labelledby="object-h">
    <h2 id="object-h" class="text-sm font-medium tracking-wide text-muted uppercase">To object</h2>
    <p class="mt-2 text-sm">
      FantasyScout is free, non-commercial and not affiliated with the NBA, the WNBA, ESPN, Sleeper, The Odds API or any bookmaker. If you operate one of
      these sources and object to how it is used here, <a href={sources.contact} class="underline underline-offset-4">open an issue</a> and the site will
      comply; the decision record behind this page is
      <a href="https://github.com/rodelBeronilla/fantasyscout/blob/main/docs/adr/0008-stats-terms-and-private-tables.md" class="underline underline-offset-4">ADR 0008</a>.
    </p>
  </section>
</Base>
