---
import Dashboards from '../../components/Dashboards';
import Base from '../../layouts/Base.astro';

// Set by the deploy from the TABLEAU_VIZ_URL repository variable once the workbook is published.
const vizUrl = import.meta.env.PUBLIC_TABLEAU_VIZ_URL ?? '';
---

<Base
  title="Dashboards"
  description="League Pulse, a Tableau Public workbook over a gold extract: team pace and ratings, player value, data health."
>
  <section>
    <h1 class="text-2xl font-semibold tracking-tight">Dashboards</h1>
    <p class="mt-1 text-sm text-muted">
      League Pulse: team pace and ratings, the distribution of player value on the board, and the
      data-health trend, built in Tableau Public from an extract of the gold tables that every build refreshes.
    </p>
    <div class="mt-6">
      <Dashboards client:load vizUrl={vizUrl} />
    </div>
  </section>
</Base>
