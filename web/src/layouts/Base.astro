---
import '../styles/global.css';
import { BUILD_ID, LEAGUES, REPO_URL, href } from '../lib/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  ['Board', '/'],
  ['Streamers', '/streamers/'],
  ['Trade', '/trade/'],
  ['Data Health', '/health/'],
  ['Notebooks', '/notebooks/'],
  ['Dashboards', '/dashboards/'],
  ['Pipeline', '/pipeline/'],
  ['Schema', '/schema/'],
  ['Docs', '/docs/'],
] as const;
// Pages that are not ready for everyone yet: the League page waits on the Yahoo import and the
// SQL console is for the owner. They sit under one dropdown so the main nav shows what is ready.
const comingSoon = [
  ['League', '/league/'],
  ['SQL console', '/sql/'],
] as const;
const current = Astro.url.pathname;
const inComingSoon = comingSoon.some(([, path]) => path === current);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · FantasyScout</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script src="../scripts/theme.ts"></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <header class="border-b border-line">
      <nav
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3"
        aria-label="Primary"
      >
        <a href={href('/')} class="text-lg font-semibold tracking-tight">FantasyScout</a>
        <ul class="flex flex-wrap items-center gap-1 text-sm">
          {
            nav.map(([label, path]) => (
              <li>
                <a
                  href={href(path)}
                  class:list={[
                    'rounded px-2 py-1 underline-offset-4 hover:underline',
                    current === path ? 'font-semibold' : 'text-muted',
                  ]}
                  aria-current={current === path ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li class="relative">
            <details class="group" open={inComingSoon || undefined} data-testid="coming-soon">
              <summary
                class:list={[
                  'cursor-pointer list-none rounded px-2 py-1 underline-offset-4 hover:underline',
                  inComingSoon ? 'font-semibold' : 'text-muted',
                ]}
              >
                Coming soon <span aria-hidden="true" class="text-xs">▾</span>
              </summary>
              <ul class="absolute left-0 z-20 mt-1 min-w-44 rounded border border-line bg-card p-1 shadow">
                {
                  comingSoon.map(([label, path]) => (
                    <li>
                      <a
                        href={href(path)}
                        class:list={[
                          'block rounded px-2 py-1 underline-offset-4 hover:underline',
                          current === path ? 'font-semibold' : 'text-muted',
                        ]}
                        aria-current={current === path ? 'page' : undefined}
                      >
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>
        </ul>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1 rounded-full border border-line p-1" role="group" aria-label="League">
            {
              LEAGUES.map((l) => (
                <a
                  href={`?league=${l.id}`}
                  data-league={l.id}
                  class="rounded-full px-3 py-1 text-sm text-muted aria-[current=true]:bg-accent aria-[current=true]:text-accent-fg"
                >
                  {l.label}
                </a>
              ))
            }
          </div>
          <button
            type="button"
            data-theme-toggle
            class="rounded-full border border-line px-3 py-1 text-sm text-muted"
            aria-label="Toggle dark or light theme"
            title="Toggle theme"
          >
            ◐
          </button>
        </div>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-line">
      <p class="mx-auto max-w-6xl px-4 pt-4 text-sm" data-testid="source-credit">
        Statistics from <a href="https://www.nba.com/stats" class="underline underline-offset-4">NBA.com</a>{' and '}<a
          href="https://stats.wnba.com"
          class="underline underline-offset-4">WNBA.com</a
        >. Schedules, rosters, injuries, betting lines, news headlines and the fantasy market from <a href="https://www.espn.com" class="underline underline-offset-4">ESPN</a>. Waiver trends from <a href="https://sleeper.com" class="underline underline-offset-4">Sleeper</a>. Referee assignments from <a
          href="https://official.nba.com/referee-assignments/"
          class="underline underline-offset-4">NBA.com</a
        >.
        FantasyScout is free, non-commercial and not affiliated with the NBA, the WNBA, ESPN or Sleeper.
      </p>
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-sm text-muted">
        <span>
          Data as of <span data-data-as-of>no build yet</span> · Data build
          <a data-data-build-link href={href('/health/')} class="underline-offset-4 hover:underline"
            ><code data-data-build-id>none</code></a
          >
          · App <code data-build-id>{BUILD_ID}</code>
        </span>
        <a href={REPO_URL} class="underline-offset-4 hover:underline">Source on GitHub</a>
      </div>
    </footer>
    <script src="../scripts/chrome.ts"></script>
  </body>
</html>
