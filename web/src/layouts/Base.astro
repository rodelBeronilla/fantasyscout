---
import '../styles/global.css';
import { BUILD_ID, LEAGUES, REPO_URL, href } from '../lib/site';
import { SHOWS } from '../lib/visibility';

interface Props {
  title: string;
  description: string;
  /**
   * The current-build files this page reads, preloaded from the head for the visitor's league (#436),
   * so they download beside the pointer instead of after the island runs (#562). Paths under
   * data/current/, with {league} for the league.
   */
  preload?: readonly string[];
  /**
   * A page that is off for now (#936) sends its visitor here at once: the address of the page that
   * says why. The page keeps a link for a browser that does not follow the refresh.
   */
  redirect?: string;
}

const { title, description, preload, redirect } = Astro.props;
const currentBase = href('data/current/');
/** The one nav link only the site's owner sees (#940). */
const OWNER_ONLY = '/sql/';

// The nav (#724): the fantasy pages flat, in the order a manager uses them, and the pages about the
// data under one header. The header opens as a dropdown (a details element, so it works without
// script); it is bold on its own pages, and a small script keeps it closed on a click elsewhere.
const nav: { label: string; path?: string; items?: readonly (readonly [string, string])[] }[] = [
  { label: 'Rankings', path: '/' },
  { label: 'My Team', path: '/team/' },
  { label: 'Trade', path: '/trade/' },
  { label: 'Pickups', path: '/streamers/' },
  { label: 'League', path: '/league/' },
  // Draft and Notes are off for now (#936): the draft until the 2027-28 drafts, the notes until their calls are judged
  ...(SHOWS.draft ? [{ label: 'Draft', path: '/draft/' }] : []),
  ...(SHOWS.notes ? [{ label: 'Notes', path: '/notes/' }] : []),
  {
    label: 'Behind the data',
    items: [
      ['Methodology', '/methodology/'],
      ['Notebooks', '/notebooks/'],
      ['Dashboards', '/dashboards/'],
      ['Data Health', '/health/'],
      ['Pipeline', '/pipeline/'],
      ['Schema', '/schema/'],
      ['Docs', '/docs/'],
      // The console loads the full tables, which only the site's owner may read (ADR 0008), so its
      // link is hidden unless this browser has signed in as the owner (scripts/nav.ts, #940).
      ['SQL console (owner only)', OWNER_ONLY],
      ['Sources and terms', '/sources/'],
    ],
  },
];
const current = Astro.url.pathname;
// The canonical address drops the query (?league= is a view of the same page) and names the site.
const canonical = new URL(current, Astro.site ?? Astro.url).href;
const within = (items: readonly (readonly [string, string])[] | undefined) => !!items?.some(([, path]) => path === current);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · FantasyScout</title>
    <meta name="description" content={description} />
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    {redirect && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="FantasyScout" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · FantasyScout`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {/* the browser's own bars take the page's ground (#963); the toggle's script keeps it in step */}
    <meta name="theme-color" content="#0b111c" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    {/* Every island starts from the build pointer: fetch it with the HTML, not after React hydrates. */}
    <link rel="preload" as="fetch" href={href('data/latest.json')} crossorigin="anonymous" />
    {
      preload && (
        <script is:inline define:vars={{ currentBase, preload }}>
          // The league the page will pick (the URL, then the remembered one, then the WNBA), so the
          // file it reads first downloads beside the pointer (#436). Same rule as lib/league.ts.
          try {
            const asked = new URLSearchParams(location.search).get('league');
            let kept = null;
            try {
              kept = localStorage.getItem('fantasyscout:current-league') || localStorage.getItem('fantasyscout.league');
            } catch {
              // storage blocked: the page falls back the same way
            }
            const league = asked === 'nba' || asked === 'wnba' ? asked : kept === 'nba' || kept === 'wnba' ? kept : 'wnba';
            for (const file of preload) {
              const link = document.createElement('link');
              link.rel = 'preload';
              link.as = 'fetch';
              link.crossOrigin = 'anonymous';
              link.href = currentBase + file.replace('{league}', league);
              document.head.appendChild(link);
            }
          } catch {
            // a preload is only a head start
          }
        </script>
      )
    }
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/nav.ts"></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <header class="border-b border-line">
      <nav
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3"
        aria-label="Primary"
      >
        <a href={href('/')} class="flex items-center gap-2 text-lg font-extrabold tracking-tight sm:text-xl" aria-label="FantasyScout">
          <svg viewBox="0 0 32 32" class="size-6 shrink-0 sm:size-7" aria-hidden="true">
            <circle cx="16" cy="16" r="15" class="fill-accent"></circle>
            <path
              d="M16 1v30M1 16h30M6.5 4.6c5 6.6 5 16.2 0 22.8M25.5 4.6c-5 6.6-5 16.2 0 22.8"
              fill="none"
              class="stroke-bg"
              stroke-width="2.2"></path>
          </svg>
          <span>Fantasy<span class="text-accent">Scout</span></span>
        </a>
        <!-- on a phone the logo and the league toggle share the first row, the menu the second (#696) -->
        <ul class="order-3 -ml-1 flex w-full flex-wrap items-center gap-0.5 text-sm sm:order-none sm:ml-0 sm:w-auto sm:gap-1">
          {
            nav.map((group) =>
              group.path ? (
                <li>
                  <a
                    href={href(group.path)}
                    class:list={[
                      'block rounded-full px-3 py-1',
                      current === group.path ? 'bg-accent font-semibold text-accent-fg' : 'text-muted hover:bg-card hover:text-fg',
                    ]}
                    aria-current={current === group.path ? 'page' : undefined}
                  >
                    {group.label}
                  </a>
                </li>
              ) : (
                <li class="relative">
                  <details data-nav-group data-current={within(group.items) || undefined} data-testid={`nav-${group.label.toLowerCase().replace(/\s+/g, '-')}`}>
                    <summary
                      class:list={[
                        'cursor-pointer list-none rounded-full px-3 py-1',
                        within(group.items) ? 'bg-accent font-semibold text-accent-fg' : 'text-muted hover:bg-card hover:text-fg',
                      ]}
                    >
                      {group.label} <span aria-hidden="true" class="text-xs">▾</span>
                    </summary>
                    <ul class="absolute left-0 z-20 mt-1 min-w-48 rounded-lg border border-line bg-card p-1.5 shadow">
                      {
                        group.items?.map(([label, path]) => (
                          <li hidden={path === OWNER_ONLY} data-owner-only={path === OWNER_ONLY || undefined}>
                            <a
                              href={href(path)}
                              class:list={[
                                'block rounded px-2.5 py-1.5 hover:bg-bg hover:text-fg',
                                current === path ? 'font-semibold text-accent' : 'text-muted',
                              ]}
                              aria-current={current === path ? 'page' : undefined}
                              target={path === '/docs/' ? '_blank' : undefined}
                              rel={path === '/docs/' ? 'noopener' : undefined}
                            >
                              {label}
                              {path === '/docs/' && <span class="sr-only"> (opens in a new tab)</span>}
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                  </details>
                </li>
              ),
            )
          }
        </ul>
        <div class="order-2 flex items-center gap-2 sm:order-none">
          <div class="flex items-center gap-1 rounded-full border border-line bg-card p-1" role="group" aria-label="League">
            {
              LEAGUES.map((l) => (
                <a
                  href={`?league=${l.id}`}
                  data-league={l.id}
                  class="rounded-full px-2.5 py-1 text-sm text-muted hover:text-fg sm:px-3 aria-[current=true]:bg-line aria-[current=true]:font-semibold aria-[current=true]:text-fg"
                >
                  {l.label}
                </a>
              ))
            }
          </div>
          <button
            type="button"
            data-theme-toggle
            class="rounded-full border border-line bg-card px-3 py-1.5 text-sm text-muted hover:text-fg"
            aria-label="Toggle dark or light theme"
            title="Toggle theme"
          >
            ◐
          </button>
        </div>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-line">
      <p class="mx-auto max-w-6xl px-4 pt-4 text-sm" data-testid="source-credit">
        Statistics from <a href="https://www.nba.com/stats" class="underline underline-offset-4">NBA.com</a>{' and '}<a
          href="https://stats.wnba.com"
          class="underline underline-offset-4">WNBA.com</a
        >. Schedules, rosters, injuries, betting lines, news headlines and the fantasy market from <a href="https://www.espn.com" class="underline underline-offset-4">ESPN</a>. Waiver trends from <a href="https://sleeper.com" class="underline underline-offset-4">Sleeper</a>. Referee assignments from <a
          href="https://official.nba.com/referee-assignments/"
          class="underline underline-offset-4">NBA.com</a
        >.
        FantasyScout is free, non-commercial and not affiliated with the NBA, the WNBA, ESPN, Sleeper, The Odds API or any bookmaker.{' '}
        <a href={href('/sources/')} class="underline underline-offset-4" data-testid="sources-link">Sources, terms and what is published</a>.
      </p>
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-sm text-muted">
        <span>
          Data as of <span data-data-as-of>no build yet</span> · Data build
          <a data-data-build-link href={href('/health/')} class="underline-offset-4 hover:underline"
            ><code data-data-build-id>none</code></a
          >
          · App <code data-build-id>{BUILD_ID}</code>
        </span>
        <a href={REPO_URL} class="underline-offset-4 hover:underline">Source on GitHub</a>
      </div>
    </footer>
    <script src="../scripts/chrome.ts"></script>
  </body>
</html>
