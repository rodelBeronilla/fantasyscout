# Secrets and local config: never committed. Secrets come from env vars or GitHub Actions secrets.
.env
.env.*
!.env.example
*.pem
.dev.vars
.dev.vars.*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
web/dist/
web/.astro/
web/playwright-report/
web/test-results/
worker/.wrangler/
worker/worker-configuration.d.ts

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
*.duckdb
*.duckdb.wal

# Data landed locally during development
landing/
data/

# Notebooks
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
dbt/.user.yml

# Local data export for the dev server (fs-export build --store local)
web/public/data/

# The Playwright fixture export is committed (a real export of the dbt sample)
!web/tests/fixtures/data/
!web/tests/fixtures/data/**

# Rendered notebooks
notebooks/_build/

# The Tableau extract is generated and published with each build
tableau/extract/
