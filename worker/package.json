{
  "name": "fantasyscout-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --env production && wrangler deploy --dry-run --env preview",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "npm run types && vitest run",
    "csp": "node scripts/csp-hashes.mjs",
    "lint": "knip",
    "pretypecheck": "npm run csp",
    "predev": "npm run csp",
    "pretest": "npm run csp",
    "precheck": "npm run csp",
    "predeploy": "npm run csp"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261031.1",
    "knip": "6.44.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.153.0"
  }
}
